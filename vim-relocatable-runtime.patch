--- a/src/os_unix.c
+++ b/src/os_unix.c
@@ -1545,6 +1545,33 @@
 #endif
 }
 
+#if defined(USE_EXE_NAME) && !defined(MACOS_X)
+/*
+ * unpins: populate the global `exe_name` from /proc/self/exe (Linux). This is
+ * the Unix counterpart of os_win32.c's mch_get_exe_name(); upstream vim only
+ * implements it on Windows, so the USE_EXE_NAME code paths in misc1.c are
+ * dead on plain Unix. Called lazily from vim_getenv() on first use.
+ *
+ * On platforms without /proc (BSDs without procfs), readlink fails and
+ * exe_name stays NULL; fallbacks (helpfile, pathdef) take over.
+ */
+    void
+mch_get_exe_name(void)
+{
+    char_u  buf[MAXPATHL + 1];
+    ssize_t len;
+
+    if (exe_name != NULL)
+	return;
+    len = readlink("/proc/self/exe", (char *)buf, MAXPATHL);
+    if (len > 0 && len <= MAXPATHL)
+    {
+	buf[len] = NUL;
+	exe_name = vim_strsave(buf);
+    }
+}
+#endif
+
     void
 mch_init(void)
 {
